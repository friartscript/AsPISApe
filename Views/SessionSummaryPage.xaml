<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AsPISApe.Views.SessionSummaryPage"
             BackgroundColor="#F5F7FB"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False">

    <Grid MaximumWidthRequest="450"
          HorizontalOptions="Center"
          Padding="20, 20, 20, 18">

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="16" VerticalOptions="Center">

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border WidthRequest="72"
                            HeightRequest="72"
                            StrokeShape="RoundRectangle 36"
                            Stroke="#2C3445"
                            StrokeThickness="2.5"
                            BackgroundColor="#FCE38A"
                            HorizontalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#E8C857" Offset="0, 4" Radius="10" Opacity="0.5" />
                        </Border.Shadow>
                        <Label x:Name="CrownBadgeLabel"
                               Text="👑"
                               FontSize="36"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label x:Name="CelebrationTitleLabel"
                           Text="Session Terminée !"
                           FontSize="22"
                           FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           TextColor="#2C3445"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="CelebrationSubtitleLabel"
                           Text="Bel effort ! Continue pour devenir un as du PISA."
                           FontSize="12"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border BackgroundColor="#FFFFFF"
                        Stroke="#2C3445"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 24"
                        Padding="18, 16">
                    <Border.Shadow>
                        <Shadow Brush="#CBD5E1" Offset="0, 6" Radius="12" Opacity="0.45" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">

                            <Border Grid.Column="0"
                                    BackgroundColor="#F5F7FB"
                                    Stroke="#2C3445"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="10, 8">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="SCORE"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#64748B"
                                           HorizontalTextAlignment="Center" />
                                    <Label x:Name="SummaryScoreLabel"
                                           Text="5 / 5"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="#2C3445"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    BackgroundColor="#F5F7FB"
                                    Stroke="#2C3445"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="10, 8">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="TEMPS"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#64748B"
                                           HorizontalTextAlignment="Center" />
                                    <Label x:Name="SummaryTimeLabel"
                                           Text="01:12"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="#2C3445"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">

                            <Border Grid.Column="0"
                                    BackgroundColor="#FFE8D6"
                                    Stroke="#2C3445"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="10, 8">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="COMBO MAX"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#2C3445"
                                           HorizontalTextAlignment="Center" />
                                    <Label x:Name="SummaryComboLabel"
                                           Text="x2.0 🔥"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#2C3445"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    BackgroundColor="#DCFCE7"
                                    Stroke="#2C3445"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="10, 8">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="XP GAGNÉE"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#166534"
                                           HorizontalTextAlignment="Center" />
                                    <Label x:Name="SummaryXpLabel"
                                           Text="+85 XP"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#166534"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <Border BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="12, 10">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label x:Name="SummaryPalierLabel"
                                           Text="Progression Palier 1"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#2C3445" />
                                    <Label Grid.Column="1"
                                           x:Name="SummaryStarsLabel"
                                           Text="★ ☆ ☆"
                                           FontSize="12"
                                           TextColor="#2C3445" />
                                </Grid>
                                <Border HeightRequest="10"
                                        BackgroundColor="#E2E8F0"
                                        Stroke="#2C3445"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 5"
                                        Padding="1">
                                    <Border x:Name="SummaryProgressBar"
                                            HorizontalOptions="Start"
                                            WidthRequest="80"
                                            BackgroundColor="#82D8A7"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">

                    <Border HeightRequest="52"
                            Stroke="#2C3445"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#7BC6F7" Offset="0.0" />
                                <GradientStop Color="#4A9FE2" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#4A9FE2" Offset="0, 6" Radius="12" Opacity="0.45" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReplayTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="REJOUER UNE SESSION ➔"
                               FontSize="14"
                               FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               TextColor="#FFFFFF"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Border HeightRequest="48"
                            BackgroundColor="#FFFFFF"
                            Stroke="#2C3445"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 20">
                        <Border.Shadow>
                            <Shadow Brush="#CBD5E1" Offset="0, 4" Radius="8" Opacity="0.4" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShareTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="♠"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#2C3445"
                                   VerticalOptions="Center" />
                            <Label Text="PARTAGER MON AS (DÉFI)"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="#2C3445"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border HeightRequest="46"
                            BackgroundColor="#F5F7FB"
                            Stroke="#2C3445"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 18">
                        <Border.Shadow>
                            <Shadow Brush="#CBD5E1" Offset="0, 3" Radius="6" Opacity="0.3" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="RETOUR À L'ACCUEIL"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#64748B"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
