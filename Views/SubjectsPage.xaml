<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AsPISApe.Views.SubjectsPage"
             BackgroundColor="#F5F7FB"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False">

    <Grid MaximumWidthRequest="450"
          HorizontalOptions="Center"
          RowDefinitions="Auto, Auto, *"
          Padding="16, 16, 16, 12">

        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Stroke="#2C3445"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 22"
                Padding="12, 10"
                Margin="0, 0, 0, 12">
            <Border.Shadow>
                <Shadow Brush="#CBD5E1" Offset="0, 4" Radius="8" Opacity="0.5" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">

                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 20"
                        Stroke="#2C3445"
                        StrokeThickness="1.5"
                        BackgroundColor="#F5F7FB"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                        <PointerGestureRecognizer PointerEntered="OnButtonPointerEntered"
                                                  PointerExited="OnButtonPointerExited" />
                    </Border.GestureRecognizers>
                    <Label Text="←"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#2C3445"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="Catalogue des Sujets"
                           FontSize="16"
                           FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           TextColor="#2C3445" />
                    <Label x:Name="SubjectCountLabel"
                           Text="Chargement..."
                           FontSize="11"
                           TextColor="#64748B" />
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        WidthRequest="38"
                        HeightRequest="38"
                        StrokeShape="RoundRectangle 19"
                        Stroke="#2C3445"
                        StrokeThickness="1.5"
                        BackgroundColor="#FFFFFF"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnResetFiltersTapped" />
                        <PointerGestureRecognizer PointerEntered="OnButtonPointerEntered"
                                                  PointerExited="OnButtonPointerExited" />
                    </Border.GestureRecognizers>
                    <Label Text="♠"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#2C3445"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="0, 0, 0, 10">

            <Border BackgroundColor="#FFFFFF"
                    Stroke="#2C3445"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 16"
                    HeightRequest="44"
                    Padding="12, 0">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="🔍"
                           FontSize="14"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           x:Name="SearchEntry"
                           Placeholder="Rechercher une notion, un théorème, un mot..."
                           FontSize="13"
                           TextColor="#2C3445"
                           PlaceholderColor="#94A3B8"
                           TextChanged="OnSearchTextChanged"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <HorizontalStackLayout Spacing="6" HorizontalOptions="Fill">

                <Border x:Name="BtnDisciplineAll"
                        HeightRequest="34"
                        Padding="10, 0"
                        Stroke="#2C3445"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#6CB4EE">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterDisciplineAllTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblDisciplineAll"
                           Text="Toutes matières"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           VerticalOptions="Center" />
                </Border>

                <Border x:Name="BtnDisciplineMaths"
                        HeightRequest="34"
                        Padding="10, 0"
                        Stroke="#2C3445"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#FFFFFF">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterDisciplineMathsTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblDisciplineMaths"
                           Text="📐 Maths"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#2C3445"
                           VerticalOptions="Center" />
                </Border>

                <Border x:Name="BtnDisciplineFrancais"
                        HeightRequest="34"
                        Padding="10, 0"
                        Stroke="#2C3445"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#FFFFFF">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterDisciplineFrancaisTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblDisciplineFrancais"
                           Text="📖 Français"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#2C3445"
                           VerticalOptions="Center" />
                </Border>

            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="6" HorizontalOptions="Fill">

                <Border x:Name="BtnLevelAll"
                        HeightRequest="32"
                        Padding="10, 0"
                        Stroke="#2C3445"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#2C3445">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterLevelAllTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblLevelAll"
                           Text="Tous cycles"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           VerticalOptions="Center" />
                </Border>

                <Border x:Name="BtnLevelCollege"
                        HeightRequest="32"
                        Padding="10, 0"
                        Stroke="#2C3445"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#FFFFFF">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterLevelCollegeTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblLevelCollege"
                           Text="🏫 Collège"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#2C3445"
                           VerticalOptions="Center" />
                </Border>

                <Border x:Name="BtnLevelLycee"
                        HeightRequest="32"
                        Padding="10, 0"
                        Stroke="#2C3445"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#FFFFFF">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterLevelLyceeTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblLevelLycee"
                           Text="🎓 Lycée"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#2C3445"
                           VerticalOptions="Center" />
                </Border>

            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="6">

                <HorizontalStackLayout x:Name="RowClassCollege" Spacing="6" HorizontalOptions="Fill">

                    <Border x:Name="ChipClassAll"
                            HeightRequest="32"
                            Padding="10, 0"
                            Stroke="#2C3445"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#2C3445">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipClassAllTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="LblClassAll"
                               Text="Toutes classes"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"
                               VerticalOptions="Center" />
                    </Border>

                    <Border x:Name="ChipClass6e"
                            HeightRequest="32"
                            Padding="10, 0"
                            Stroke="#2C3445"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipClass6eTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="LblClass6e"
                               Text="6e"
                               FontSize="11"
                               TextColor="#2C3445"
                               VerticalOptions="Center" />
                    </Border>

                    <Border x:Name="ChipClass5e"
                            HeightRequest="32"
                            Padding="10, 0"
                            Stroke="#2C3445"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipClass5eTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="LblClass5e"
                               Text="5e"
                               FontSize="11"
                               TextColor="#2C3445"
                               VerticalOptions="Center" />
                    </Border>

                    <Border x:Name="ChipClass4e"
                            HeightRequest="32"
                            Padding="10, 0"
                            Stroke="#2C3445"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipClass4eTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="LblClass4e"
                               Text="4e"
                               FontSize="11"
                               TextColor="#2C3445"
                               VerticalOptions="Center" />
                    </Border>

                    <Border x:Name="ChipClass3e"
                            HeightRequest="32"
                            Padding="10, 0"
                            Stroke="#2C3445"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipClass3eTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="LblClass3e"
                               Text="3e"
                               FontSize="11"
                               TextColor="#2C3445"
                               VerticalOptions="Center" />
                    </Border>

                </HorizontalStackLayout>

                <HorizontalStackLayout x:Name="RowClassLycee" Spacing="6" HorizontalOptions="Fill">

                    <Border x:Name="ChipClass2de"
                            HeightRequest="32"
                            Padding="10, 0"
                            Stroke="#2C3445"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipClass2deTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="LblClass2de"
                               Text="2de"
                               FontSize="11"
                               TextColor="#2C3445"
                               VerticalOptions="Center" />
                    </Border>

                    <Border x:Name="ChipClass1re"
                            HeightRequest="32"
                            Padding="10, 0"
                            Stroke="#2C3445"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipClass1reTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="LblClass1re"
                               Text="1re Spé"
                               FontSize="11"
                               TextColor="#2C3445"
                               VerticalOptions="Center" />
                    </Border>

                    <Border x:Name="ChipClassTleSpe"
                            HeightRequest="32"
                            Padding="10, 0"
                            Stroke="#2C3445"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipClassTleSpeTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="LblClassTleSpe"
                               Text="Tle Spé"
                               FontSize="11"
                               TextColor="#2C3445"
                               VerticalOptions="Center" />
                    </Border>

                    <Border x:Name="ChipClassTleExp"
                            HeightRequest="32"
                            Padding="10, 0"
                            Stroke="#2C3445"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChipClassTleExpTapped" />
                        </Border.GestureRecognizers>
                        <Label x:Name="LblClassTleExp"
                               Text="Tle Expertes"
                               FontSize="11"
                               TextColor="#2C3445"
                               VerticalOptions="Center" />
                    </Border>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>

        <Grid Grid.Row="2">

            <ScrollView x:Name="SubjectsScrollView"
                        VerticalScrollBarVisibility="Default">
                <VerticalStackLayout x:Name="SubjectsCardsLayout"
                                     Spacing="10"
                                     Padding="0, 2, 0, 16" />
            </ScrollView>

            <Border x:Name="EmptyStateView"
                    IsVisible="False"
                    BackgroundColor="#FFFFFF"
                    Stroke="#2C3445"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 22"
                    Padding="24"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="340">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="🔍"
                           FontSize="40"
                           HorizontalOptions="Center" />
                    <Label Text="Aucun sujet trouvé"
                           FontSize="16"
                           FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           TextColor="#2C3445"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Aucune notion ne correspond à vos filtres. Essayez de réinitialiser la recherche."
                           FontSize="12"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                    <Border BackgroundColor="#6CB4EE"
                            Stroke="#2C3445"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="42"
                            Padding="16, 0"
                            HorizontalOptions="Center"
                            Margin="0, 8, 0, 0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResetFiltersTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="RÉINITIALISER LES FILTRES"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
